{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineer-agent-workflows.invalid/schemas/decisions.schema.json",
  "title": "Decisions workflow contract v1",
  "type": "object",
  "required": [
    "schema_version",
    "spec_slug",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "specification_reviews": {
      "type": "object",
      "required": [
        "version",
        "runs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source_version",
              "specification_version",
              "status_at_start",
              "created_at",
              "completed",
              "outcome",
              "results"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source_version": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "specification_version": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "status_at_start": {
                "enum": [
                  "Draft",
                  "Approved"
                ]
              },
              "created_at": {
                "type": "string",
                "minLength": 1
              },
              "completed": {
                "type": "boolean"
              },
              "outcome": {
                "enum": [
                  "pending",
                  "gaps",
                  "reviewed"
                ]
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "item_index",
                    "item_key",
                    "verdict",
                    "explanation",
                    "requirement_ids",
                    "source_refs"
                  ],
                  "properties": {
                    "item_index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "item_key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "verdict": {
                      "enum": [
                        "covered",
                        "gap",
                        "conflict",
                        "not_applicable"
                      ]
                    },
                    "explanation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "counterexample": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "requirement_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "source_refs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "revision"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "revision": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "carried_from": {
                      "type": "object",
                      "required": [
                        "review_ref",
                        "item_key"
                      ],
                      "properties": {
                        "review_ref": {
                          "type": "string",
                          "minLength": 1
                        },
                        "item_key": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "approval_observed": {
                "type": "boolean"
              },
          "input_snapshot": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consistency_required": {
            "type": "boolean"
          },
          "followup": {
                "type": "object",
                "required": [
                  "parent_review_ref",
                  "required_item_keys",
                  "fixes"
                ],
                "properties": {
                  "parent_review_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required_item_keys": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "fixes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "finding_key",
                        "changed_item_keys",
                        "explanation"
                      ],
                      "properties": {
                        "finding_key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "changed_item_keys": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1
                        },
                        "explanation": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "expansions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "item_keys",
                        "reason"
                      ],
                      "properties": {
                        "item_keys": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "consistency": {
                "type": "object",
                "required": [
                  "verdict",
                  "explanation"
                ],
                "properties": {
                  "verdict": {
                    "enum": [
                      "consistent",
                      "gap",
                      "conflict"
                    ]
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "counterexample": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "spec_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "decisions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "category",
          "state",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "question": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "text",
                  "kind",
                  "options"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "options": {
                    "type": "array",
                    "minItems": 0,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "label"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "answer": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "text",
                  "selected_ids"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "selected_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "context_reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 4096
          },
          "instruction": {
            "type": "object",
            "required": [
              "text",
              "source",
              "kind"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "kind": {
                "enum": [
                  "initial_request",
                  "follow_up",
                  "user_edit"
                ]
              }
            },
            "additionalProperties": false
          },
          "related_decisions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "supersedes_revision": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "description": "Protocol-1 structural contract. Existing extension metadata remains supported. Revision uniqueness, supersession and authoring-state rules require the Decision Ledger MCP and workflow checks."
}
