{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineer-agent-workflows.invalid/schemas/catalog.schema.json",
  "title": "Catalog workflow contract v1",
  "type": "object",
  "required": [
    "schema_version",
    "penpot",
    "snapshot",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "penpot": {
      "type": "object",
      "required": [
        "instance",
        "team_id",
        "project_id",
        "file_id"
      ],
      "properties": {
        "instance": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "team_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "file_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "status"
      ],
      "properties": {
        "path": {
          "const": "design/system/library.penpot"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "pending",
            "verified"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "components": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "allowed_overrides",
          "accessibility",
          "variants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "allowed_overrides": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "accessibility": {
            "type": "string",
            "minLength": 1
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "main_component_id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "main_component_id": {
                  "type": "string",
                  "minLength": 1
                },
                "axes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "token_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "extensions": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "token_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "content_constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "extensions": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "tokens": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^design/system/[^/].*\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
