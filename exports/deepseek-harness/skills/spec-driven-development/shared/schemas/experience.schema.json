{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineer-agent-workflows.invalid/schemas/experience.schema.json",
  "title": "Experience workflow contract v1",
  "type": "object",
  "required": [
    "schema_version",
    "specification",
    "requirements_source",
    "system",
    "penpot",
    "snapshot",
    "screens"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "specification": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "requirements_source": {
      "type": "string",
      "pattern": "^docs/specs/[a-z0-9]+(?:-[a-z0-9]+)*/spec\\.md$"
    },
    "system": {
      "type": "object",
      "required": [
        "catalog",
        "library_file_id",
        "snapshot_sha256"
      ],
      "properties": {
        "catalog": {
          "const": "design/system/catalog.yaml"
        },
        "library_file_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "penpot": {
      "type": "object",
      "required": [
        "file_id"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "minLength": 1
        },
        "instance": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "team_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^design/specs/[a-z0-9]+(?:-[a-z0-9]+)*/screens\\.penpot$"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "pending",
            "verified"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "page_id",
          "board_id",
          "requirement_ids",
          "instances",
          "states",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "page_id": {
            "type": "string",
            "minLength": 1
          },
          "board_id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "instances": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "required": [
                "id",
                "element_id",
                "component",
                "variant",
                "library_file_id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "element_id": {
                  "type": "string",
                  "minLength": 1
                },
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "variant": {
                  "type": "string",
                  "minLength": 1
                },
                "library_file_id": {
                  "type": "string",
                  "minLength": 1
                },
                "overrides": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "extensions": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "visible"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "visible": {
                  "type": "string",
                  "minLength": 1
                },
                "entry_conditions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "exit_conditions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "focus": {
                  "type": "string",
                  "minLength": 1
                },
                "extensions": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "actions": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "required": [
                "id",
                "from",
                "to",
                "trigger",
                "requirement_ids"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "operation_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "extensions": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "responsive": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "required": [
                "id",
                "width",
                "height",
                "behavior"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "behavior": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "accessibility": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "content_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "extensions": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "snapshot": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "system": {
            "properties": {
              "snapshot_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
