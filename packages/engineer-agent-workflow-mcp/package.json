{
  "name": "@engineer-agent-workflows/engineer-agent-workflow-mcp",
  "version": "0.0.0-development",
  "description": "Scenario-specific MCP tools for specification decisions and design workflow artifacts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "engineer-agent-workflow-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-schemas.mjs && node scripts/build-runtime-info.mjs",
    "lint": "eslint src test test-support",
    "test": "npm run build && node ../../scripts/run-tests.mjs test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "6.15.0",
    "fflate": "0.8.2",
    "mdast-util-from-markdown": "2.0.3",
    "prettier": "3.9.6",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
